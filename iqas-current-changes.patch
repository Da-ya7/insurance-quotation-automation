+    private Optional<QuotationRequest> findUnambiguousPendingRequest(
+            List<Client> clients,
+            List<QuotationRequest> pendingRequests,
+            String extractedName) {
+
+        if (pendingRequests == null || pendingRequests.isEmpty()) {
+            return Optional.empty();
+        }
+
+        /*
+         * If a name was supplied, match it to exactly one client
+         * before considering that client's pending requests.
+         */
+        if (extractedName != null && !extractedName.isBlank()) {
+            Optional<Client> matchedClient =
+                    findClientByIdentity(clients, extractedName);
+
+            if (matchedClient.isEmpty()) {
+                return Optional.empty();
+            }
+
+            List<QuotationRequest> clientRequests =
+                    pendingRequests.stream()
+                            .filter(request ->
+                                    request.getClient() != null
+                                            && matchedClient.get().getId()
+                                            .equals(request.getClient().getId()))
+                            .toList();
+
+            return clientRequests.size() == 1
+                    ? Optional.of(clientRequests.get(0))
+                    : Optional.empty();
+        }
+
+        /*
+         * Without a name, link only when there is exactly one
+         * pending request across all clients using this email.
+         */
+        return pendingRequests.size() == 1
+                ? Optional.of(pendingRequests.get(0))
