+
+    private boolean isAmbiguousPendingRequest(
+            List<Client> clients,
+            List<QuotationRequest> pendingRequests,
+            String extractedName,
+            Optional<QuotationRequest> pendingMatch) {
+
+        if (pendingRequests == null || pendingRequests.isEmpty()) {
+            return false;
+        }
+
+        if (pendingMatch.isPresent()) {
+            return false;
+        }
+
+        /*
+         * A name that matches an existing client but has multiple
+         * pending requests is ambiguous as well.
+         */
+        if (extractedName != null && !extractedName.isBlank()) {
+            Optional<Client> matchedClient =
+                    findClientByIdentity(clients, extractedName);
+
+            if (matchedClient.isPresent()) {
+                long matchingRequests = pendingRequests.stream()
+                        .filter(request ->
