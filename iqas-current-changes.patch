+    private List<QuotationRequest> findPendingRequests(
+            List<Client> clients) {
+
+        if (clients == null || clients.isEmpty()) {
+            return List.of();
+        }
+
+        Set<Long> clientIds = clients.stream()
+                .map(Client::getId)
+                .filter(id -> id != null)
+                .collect(Collectors.toSet());
 
+        if (clientIds.isEmpty()) {
+            return List.of();
+        }
+
+        List<QuotationRequest> pending = new ArrayList<>();
+
+        pending.addAll(
+                quotationRequestRepository.findByStatus(
+                        RequestStatus.MISSING_INFORMATION));
+
+        pending.addAll(
+                quotationRequestRepository.findByStatus(
+                        RequestStatus.WAITING_FOR_CLIENT));
+
+        Map<Long, QuotationRequest> uniqueRequests =
+                new LinkedHashMap<>();
+
+        for (QuotationRequest request : pending) {
+            if (request.getId() == null
+                    || request.getClient() == null
+                    || request.getClient().getId() == null) {
+                continue;
+            }
+
+            if (clientIds.contains(request.getClient().getId())) {
+                uniqueRequests.put(request.getId(), request);
+            }
+        }
+
+        return new ArrayList<>(uniqueRequests.values());
+    }
